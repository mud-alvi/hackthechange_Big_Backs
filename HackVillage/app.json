{
  "expo": {
    "name": "HackVillage",
    "slug": "hackvillage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_main.png",
    "scheme": "hackvillage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo_main.icon",
      "bundleIdentifier": "com.hackvillage.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.hackvillage.app",
      "adaptiveIcon": {
        "backgroundColor": "#8E63AB",
        "foregroundImage": "./assets/images/logo_main.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8E63AB",
          "image": "./assets/images/logo_main.png",
          "imageWidth": 150
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Connect to your HackVillage board to receive in-person encounters."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "village-requests",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/with-board-background"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e01c722d-79e8-4116-aa9b-1d3aa8eecf03"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e01c722d-79e8-4116-aa9b-1d3aa8eecf03"
    }
  }
}
